__pycache__/
*.pyc
*.pyo
.env
*.log

# Runtime / generated data (never commit)
cache/
kb/
docs/
logs/

# Per-buyer release builds + private buyer ledger (NEVER commit / ship)
releases/
buyers_manifest.csv

# Internal operator docs — never commit, never ship in buyer ZIP
# (make_release.sh also rsync/cp-excludes _INTERNAL_* so it can't leak)
_INTERNAL_*

# Local file-backup safety copies — never commit / ship
.backups/
*.bak
# Timestamped backups too: `*.bak` does NOT match `foo.py.bak-fix-20261019`.
# Measured 2026-10-19: a procedures/*.py.bak-orphanfix-<ts> showed up as
# untracked during a release and had to be moved out by hand. Base already
# carries this pattern; neuron only had the scripts/install.sh special case.
*.bak-*

# Zero-LLM gate re-fire guard state (runtime, per-host, never commit)
scripts/.check_*.last_run
scripts/.stall_watch.ledger.json

# local code-structure index (built on demand, never versioned)
kb/code_graph/

# Internal operator scripts (buyer watermark/leak tracer — never ship)
scripts/make_release.sh
scripts/trace_release.sh

# installer backups (local only)
scripts/install.sh.bak-*

# Workspace root files are NEVER part of this product. The installer writes its
# own managed block into the USER's $WS/TOOLS.md (TOOLS_BODY heredoc in
# scripts/install.sh) and never reads a TOOLS.md from this repo -- so a copy
# here is dead weight that only ever leaks the operator's own tool catalog.
# Measured 2026-10-27: a stray TOOLS.md shipped 13 analyst-private tool entries
# into 248 buyer ZIPs across 19 buyers before anyone noticed.
TOOLS.md
AGENTS.md
SOUL.md
IDENTITY.md
MEMORY.md
